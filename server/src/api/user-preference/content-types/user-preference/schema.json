{
  "kind": "collectionType",
  "collectionName": "user_preferences",
  "info": {
    "singularName": "user-preference",
    "pluralName": "user-preferences",
    "displayName": "User Preference",
    "description": "User preferences extracted from chat conversations"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "client": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::client.client",
      "inversedBy": "preferences"
    },
    "preference_type": {
      "type": "enumeration",
      "enum": ["author", "publisher", "category", "year_range", "price_range", "genre"],
      "required": true
    },
    "preference_value": {
      "type": "text",
      "required": true
    },
    "confidence_score": {
      "type": "decimal",
      "min": 0,
      "max": 1,
      "default": 0.5
    },
    "extracted_from_conversation": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::chat-conversation.chat-conversation"
    }
  }
}
